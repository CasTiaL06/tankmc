{
  "name": "tankclient",
  "version": "0.1.0",
  "description": "TankClient Minecraft Launcher",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p electron && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -p electron && tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "typecheck": "tsc -p electron --noEmit && tsc --noEmit",
    "dist:setup": "npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.tankclient.launcher",
    "productName": "TankClient",
    "copyright": "TankClient contributors",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TankClient",
      "deleteAppDataOnUninstall": false,
      "artifactName": "TankClient-Setup-${version}.exe",
      "language": "1055"
    },
    "portable": {
      "artifactName": "TankClient-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "private": true,
  "license": "MIT",
  "author": "TankClient",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasTiaL06/tankmc.git"
  },
  "homepage": "https://github.com/CasTiaL06/tankmc"
}
